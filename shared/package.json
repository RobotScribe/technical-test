{
	"name": "@shared/types",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"lint": "eslint .",
		"format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,html}\" --ignore-path ../.prettierignore",
		"format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,html}\" --ignore-path ../.prettierignore",
		"types": "tsc -p tsconfig.json --noEmit",
		"check": "pnpm format:check && pnpm lint && pnpm types"
	},
	"devDependencies": {
		"@eslint/js": "^9.17.0",
		"eslint": "^9.17.0",
		"typescript": "~5.6.2",
		"typescript-eslint": "^8.18.2"
	}
}
